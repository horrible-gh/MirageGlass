# Fixed token for the create/delete API. The server refuses to start if it is empty.
MIRAGEGLASS_TOKEN=change-me

# Storage root (default: <project root>/storage)
# MIRAGEGLASS_STORAGE=C:/storage/mirageglass

# Upload limits
MIRAGEGLASS_MAX_ZIP_BYTES=209715200
MIRAGEGLASS_MAX_ENTRIES=5000
MIRAGEGLASS_MAX_TOTAL_BYTES=524288000
MIRAGEGLASS_MAX_ENTRY_BYTES=104857600

# Capture
MIRAGEGLASS_CAPTURE_WIDTH=1280
MIRAGEGLASS_CAPTURE_HEIGHT=800
MIRAGEGLASS_CAPTURE_TIMEOUT_MS=20000
